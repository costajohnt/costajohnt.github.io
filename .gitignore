.superpowers/
notes/
.worktrees/
.claude/
# Design explorations parked in the repo root; tracked would mean published
# (the deploy serves every tracked file), so ignore explicitly.
redesign-mockups/
node_modules/
.wrangler/
.venv/
__pycache__/
.env
# Anything derived from .env carries the same values, and generated backups
# (.env.bak.<epoch>) landed next to it untracked and unignored. Ignore the
# family, not just the one filename; re-include templates explicitly.
.env.*
!.env.example
!.env.sample
*.tmp
